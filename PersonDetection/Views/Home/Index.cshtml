@{
    ViewData["Title"] = "PersonDetection";
}

<button id="detect_from_disk" class="inline-element">Detect from disk</button>
<p id="result" class="inline-element"></p>
<br/><br/>
<input type="text" id="image_url" class="inline-element" placeholder="Enter image URL" />
<button id="detect_from_url" class="inline-element">Detect from URL</button>
<p id="result_url" class="inline-element"></p>
<br/><br/>
<div>
    <form id="upload_form" enctype="multipart/form-data">
        <input type="file" id="file_input" name="file" class="inline-element" style="border: 1px solid black;" />
        <button type="submit" id="upload_button" class="inline-element">Detect from file</button>
        <p id="upload_result" class="inline-element"></p>
    </form>
</div>

@section Styles {
    <style>
        .inline-element {
            display: inline-block;
            margin-right: 10px;
        }
    </style>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#detect_from_disk").click(function () {
                $("#result").text("Work in progress...");
                
                $.ajax({
                    url: '/Home/GetPersonCount',
                    type: 'GET',
                    success: function (data) {
                        $("#result").text("Number of people detected: " + data.count);
                    },
                    error: function () {
                        $("#result").text("An error occurred while detecting people.");
                    }
                });
            });

            $("#detect_from_url").click(function () {
                const imageUrl = $("#image_url").val();
                if (!imageUrl) {
                    $("#result_url").text("Please enter a valid URL.");
                    return;
                }

                $("#result_url").text("Work in progress...");
                
                $.ajax({
                    url: '/Home/GetPersonCountFromUrl',
                    type: 'GET',
                    data: { imageUrl: imageUrl },
                    success: function (data) {
                        if (data.count !== undefined) {
                            $("#result_url").text("Number of people detected: " + data.count);
                        } else {
                            $("#result_url").text("Error: " + data.error);
                        }
                    },
                    error: function () {
                        $("#result_url").text("An error occurred while detecting people.");
                    }
                });
            });

            $("#upload_form").submit(function (event) {
                event.preventDefault();
                
                const formData = new FormData(this);
                $("#upload_result").text("Work in progress...");
                $.ajax({
                    url: '/Home/UploadAndDetect',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        if (data.count >= 0) {
                            $("#upload_result").text("Number of people detected: " + data.count);
                        } else {
                            $("#upload_result").text("Error: " + (data.error || "Unknown error"));
                        }
                    },
                    error: function () {
                        $("#upload_result").text("An error occurred while detecting people.");
                    }
                });
            });
        });
    </script>
}